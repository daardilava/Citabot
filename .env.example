# Copia este archivo como .env para cambiar la configuración. Todo es opcional.
CITABOT_HOST=127.0.0.1
CITABOT_PORT=8000
# CITABOT_DB_PATH=data/citabot.db

# «Ver la demo» entra al negocio de ejemplo sin contraseña. Pon 0 antes de publicar el servidor.
CITABOT_DEMO_LOGIN=1
# Pon 1 cuando el servidor esté detrás de HTTPS: la cookie de sesión solo viajará cifrada.
CITABOT_COOKIE_SECURE=0

# "simulator" no envía nada fuera de tu equipo. "whatsapp_cloud" usa la API de Meta.
MESSAGING_PROVIDER=simulator
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# "rules" entiende los mensajes con reglas, sin costo. "llm" usa Claude (requiere
# `pip install anthropic` y una API key); si la llamada falla, vuelve a las reglas.
NLU_PROVIDER=rules
# "extractive" cita el fragmento de la base de conocimiento tal cual. "llm" hace que
# Claude redacte la respuesta con esos fragmentos; si no la contienen, pasa a una persona.
ANSWER_PROVIDER=extractive
# Con ANSWER_PROVIDER=llm, una base de conocimiento de hasta este tamaño (en caracteres)
# se le pasa completa a Claude en cada pregunta. Con 0 siempre se busca por palabras.
# CITABOT_WHOLE_BASE_MAX_CHARS=12000
ANTHROPIC_API_KEY=
# CITABOT_LLM_MODEL=claude-opus-5-5
# El cliente se conecta solo por IPv4, porque en redes con IPv6 mal enrutado cada
# conexión nueva tarda ~20 s más. Pon 0 únicamente si tu red es solo IPv6.
# CITABOT_LLM_IPV4_ONLY=1
